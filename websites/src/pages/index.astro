---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideBrowser from '../components/GuideBrowser.astro';
import { isPublished, sortByVerifiedDesc } from '../lib/content';

const allGuides = await getCollection('guides', isPublished);
const latest = sortByVerifiedDesc(allGuides);
---
<BaseLayout title="الرئيسية">
  <h1 class="text-2xl font-bold mb-6">أدلة الخدمات الحكومية والتعليمية</h1>
  <GuideBrowser guides={latest} />
</BaseLayout>
