---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublished, needsRecheck } from '../../lib/content';

export async function getStaticPaths() {
  const guides = await getCollection('guides', isPublished);
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
}
const { guide } = Astro.props;
const { Content } = await guide.render();
const recheck = needsRecheck(guide);
const formattedDate = new Intl.DateTimeFormat('ar', { dateStyle: 'long' }).format(guide.data.lastVerifiedDate);
---
<BaseLayout title={guide.data.title} description={guide.data.excerpt}>
  <article>
    <span class="text-xs text-brand font-medium">{guide.data.country} · {guide.data.serviceType.replace('_', ' ')}</span>
    <h1 class="text-3xl font-bold mt-2 mb-2">{guide.data.title}</h1>

    {recheck && (
      <div class="bg-amber-50 border border-amber-200 text-amber-800 text-sm rounded p-3 mb-4">
        ⚠️ هذا الدليل قيد إعادة التحقق — قد يكون الإجراء الرسمي قد تغيّر. تحقق دائمًا من المصدر الرسمي أدناه.
      </div>
    )}

    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>

    <div class="mt-8 pt-4 border-t border-neutral-200 text-sm text-neutral-600 space-y-2">
      <p><strong>آخر تحقق:</strong> {formattedDate}</p>
      <p>
        <strong>المصدر الرسمي:</strong>{' '}
        <a href={guide.data.officialSourceUrl} target="_blank" rel="noopener noreferrer" class="text-brand underline">
          {guide.data.officialSourceUrl}
        </a>
      </p>
      <p class="italic">تنبيه: تحقق دائمًا من المصدر الرسمي، فقد تتغيّر الإجراءات الحكومية دون إشعار مسبق.</p>
    </div>
  </article>
</BaseLayout>
